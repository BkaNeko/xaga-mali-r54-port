 #if IS_ENABLED(CONFIG_MTK_GPU_COMMON_DVFS_SUPPORT) /* ENABLE_COMMON_DVFS */
-	gpu_dvfs_enable = (g_is_bringup == 1)? 0: 1;
+	/* xaga: GED's own policy cannot compute a target here -- it needs the
+	 * frame/KPI statistics that MTK's composer feeds on stock ROMs, and
+	 * without them it always resolves to the minimum OPP while still
+	 * committing periodically, which pulls the GPU to the top OPP during
+	 * idle. The in-driver kbase policy owns DVFS instead, so keep GED's
+	 * engine off by default (runtime-tunable via the gpu_dvfs_enable
